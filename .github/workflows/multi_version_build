name: Build Multiple Versions

on:
  push:
    branches: [master, release/1.21.1, release/1.21.10]
  pull_request:
    branches: [master, release/1.21.1, release/1.21.10]

jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        branch: [master, release/1.21.1, release/1.21.10x]
        include:
          - branch: master
            mc_version: 1.21.1
          - branch: release/1.21.10
            mc_version: 1.21.10
          - branch: release/1.21.1
            mc_version: 1.21.1

    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ matrix.branch }}
      
      - name: Set up JDK
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
      
      - name: Build with Gradle
        run: ./gradlew build -Pminecraft_version=${{ matrix.mc_version }}
